pref-auth-help = Šalje se pri svakom zahtevu serveru docling-serve, uključujući proveru veze. Čuva se nešifrovano u Zotero profilu — koristi ključ sa najmanjim potrebnim ovlašćenjima i HTTPS za udaljene servere.
pref-behavior-title = Ponašanje
pref-auto-convert =
    .label = Automatski pretvori nove PDF priloge pri uvozu
pref-auto-convert-help = Važi samo za nove PDF-ove, ne pretvara naknadno datoteke koje su već u biblioteci.
pref-skip-if-exists =
    .label = Preskoči stavke koje već imaju Markdown prilog
pref-max-concurrency = Uporedna pretvaranja
pref-max-concurrency-help = Broj PDF-ova koji se istovremeno pretvaraju u jednoj grupi. Podrazumevano je 1 (redom, najbezbednije). Veća vrednost ubrzava rad samo uz asinhronu obradu i docling-serve pokrenut sa --workers ≥ 2.
pref-notify-on-complete =
    .label = Sistemsko obaveštenje po završetku grupe (samo kada Zotero nije u prvom planu)
pref-confirm-reconvert =
    .label = Traži potvrdu pre nego što „Ponovo pretvori (zameni)“ zameni postojeći Markdown
pref-output-title = Izlaz
pref-attach-to-item =
    .label = Priloži .md datoteku uz Zotero stavku (preporučeno)
pref-add-frontmatter =
    .label = Dodaj YAML zaglavlje sa Zotero metapodacima
pref-frontmatter-help = Dodaje naslov, autore, godinu, doi, url, zotero_key i citation_key na početak svake .md datoteke, u YAML bloku označenom sa ---.
pref-exclude-images =
    .label = Izostavi slike — zadrži samo tekst i tabele
pref-exclude-images-help = Podrazumevano se svaka slika umeće u .md kao podatak u formatu base64, što može povećati datoteku za desetine megabajta. Kada je ova opcija uključena, svaka slika se zamenjuje kratkim komentarom <!-- image -->.
pref-export-folder = Fascikla za izvoz
pref-export-folder-help = Apsolutna putanja. Ako je uneta, svaka pretvorena .md datoteka zapisuje se i ovde. Naziv datoteke koristi ključ citata kada postoji, inače Zotero ključ stavke. Ostavi prazno da isključiš.
pref-conversion-title = Pretvaranje
pref-pipeline = Postupak obrade
